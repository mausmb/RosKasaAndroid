<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RosKasa" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pos_accent_blue</item>
        <item name="colorSecondary">@color/pos_accent_green</item>
        <item name="android:windowBackground">@color/pos_bg_dark</item>
        <item name="android:textColor">@color/pos_btn_text</item>

        <!-- Nastavitev teme za vse potrditvene dialoge v aplikaciji -->
        <item name="alertDialogTheme">@style/RosAlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/RosAlertDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/RosAlertDialogTheme</item>
    </style>

    <style name="RosAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <!-- Temno ozadje dialoga -->
        <item name="android:windowBackground">@color/pos_card_bg</item>
        <!-- Bel naslov in belo besedilo vprašanja/odločitve za maksimalno berljivost -->
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <!-- Potrditveni tekst: rumena barva za odlično vidljivost na temnem ozadju -->
        <item name="colorAccent">@color/pos_dialog_btn_yellow</item>
        <item name="colorPrimary">@color/pos_dialog_btn_yellow</item>
        <item name="buttonBarPositiveButtonStyle">@style/RosDialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/RosDialogNegativeButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/RosDialogNeutralButton</item>
    </style>

    <style name="RosDialogPositiveButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/pos_dialog_btn_yellow</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="RosDialogNegativeButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/pos_dialog_btn_cancel</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="RosDialogNeutralButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/pos_dialog_btn_yellow</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PosButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">50dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:baselineAligned">false</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <style name="DialogFullScreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/pos_bg_dark</item>
    </style>
</resources>
