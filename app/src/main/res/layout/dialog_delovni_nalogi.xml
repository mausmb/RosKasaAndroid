<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/pos_bg_dark"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvNaslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Izbira delovnega naloga"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/etSearchDn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#333333"
        android:hint="Išči delovni nalog / partnerja..."
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="10dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="#222222">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDelovniNalogi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp" />

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Ni podatkov o delovnih nalogih"
            android:textColor="#888888"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            style="@style/PosButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="#555555"
            android:text="Prekliči"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnOdstraniDn"
            style="@style/PosButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/pos_accent_red"
            android:text="Odstrani DN"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
