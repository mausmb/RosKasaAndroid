<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pos_bg_dark"
    android:padding="2dp">

    <!-- Zgornja krmilna vrstica - 5-stolpčna mreža (enaka kot na vseh formah) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="2"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="false"
        android:padding="1dp"
        android:layout_marginBottom="2dp">

        <!-- Vrstica 0: Standardna navigacijska vrstica -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMizeSelf"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_accent_blue"
            android:text="@string/btn_mize"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavRacuni"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="@string/btn_racuni"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavNaroci"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="@string/btn_naroci"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavPlacila"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="@string/btn_placila"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOdjava"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_accent_red"
            android:text="@string/btn_odjava"
            android:textColor="#FFFFFF" />

        <!-- Vrstica 1: Funkcijske tipke mize -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarker"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="Marker"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInfo"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="Info"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1" />

        <View
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1" />

        <View
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1" />
    </GridLayout>

    <!-- Sekcija Rajoni (Filter za mize) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:id="@+id/containerRajoni"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                style="@style/PosButtonStyle"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/pos_region_bg"
                android:text="Vsi"
                android:textColor="#000000"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                style="@style/PosButtonStyle"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/pos_region_bg"
                android:text="R 1"
                android:textColor="#000000"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                style="@style/PosButtonStyle"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/pos_region_bg"
                android:text="R 2"
                android:textColor="#000000"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                style="@style/PosButtonStyle"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/pos_region_bg"
                android:text="R 3"
                android:textColor="#000000"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                style="@style/PosButtonStyle"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/pos_region_bg"
                android:text="R 4"
                android:textColor="#000000"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                style="@style/PosButtonStyle"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/pos_region_bg"
                android:text="R 5"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Mreža miz (Mize 1 do N) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMizeGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="2dp"
        android:background="#1B1B1B" />

</LinearLayout>
