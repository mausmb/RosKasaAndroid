<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/pos_bg_dark"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvNaslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delitev računa (Split)"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kliknite na artikel za prenos na novi račun ali nazaj:"
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:paddingBottom="8dp" />

    <!-- Originalni račun -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#333333"
        android:padding="6dp">

        <TextView
            android:id="@+id/tvOriginalLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Originalni račun:"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOriginalZnesek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0,00 €"
            android:textColor="#4CAF50"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="#222222">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOriginalPozicije"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp" />

        <TextView
            android:id="@+id/tvEmptyOriginal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Ni preostalih postavk"
            android:textColor="#888888"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Novi deljeni račun -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1565C0"
        android:layout_marginTop="8dp"
        android:padding="6dp">

        <TextView
            android:id="@+id/tvNoviLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Novi račun (deljen):"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNoviZnesek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0,00 €"
            android:textColor="#FFEB3B"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="#222222">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNoviPozicije"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp" />

        <TextView
            android:id="@+id/tvEmptyNovi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Kliknite postavko zgoraj za prenos"
            android:textColor="#888888"
            android:visibility="visible" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            style="@style/PosButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="#555555"
            android:text="Prekliči"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnPotrdiSplit"
            style="@style/PosButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/pos_accent_blue"
            android:text="Potrdi delitev"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
