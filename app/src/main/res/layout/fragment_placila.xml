            android:textSize="8sp" />

        <!-- Vrstica 5 -->
        <Button
            android:id="@+id/btnPayNivelacija"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:padding="0dp"
