            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:padding="0dp"
            android:backgroundTint="#E65100"
            android:text="POPUST KUPON"
