<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pos_bg_dark">

    <!-- Seznam vnesenih plačil (Zgornji del, zapolni prosti prostor) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlacilaItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="2dp"
        android:background="#222222" />

    <!-- Statusna vrstica mize in zneska (Nad krmilnimi gumbi) -->
    <TextView
        android:id="@+id/tvMizaStatus"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="#111111"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="M: Miza 5  -  Zn: 4,00 / Pl: 0,00" />

    <!-- POS Krmilne Tipke za PLAČILA (3 vrstice, vsi gumbi 56dp višina) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="3"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="false"
        android:padding="1dp">

        <!-- Vrstica 1: Standardna navigacijska vrstica -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavMize"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="@string/btn_mize"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavRacuni"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="@string/btn_racuni"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavNaroci"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="@string/btn_naroci"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavPlacilaSelf"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_accent_blue"
            android:text="@string/btn_placila"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOdjava"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_accent_red"
            android:text="@string/btn_odjava"
            android:textColor="#FFFFFF" />

        <!-- Vrstica 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrisanje"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="Brisanje"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpis"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="Opis"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1" />

        <View
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIzpisRacuna"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_accent_green"
            android:text="Izpis Računa"
            android:textColor="#FFFFFF" />

        <!-- Vrstica 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPopust"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="Popust"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1" />

        <View
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTapOn"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="Tap On"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpombaRacuna"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="OPOMBA\nRAČUNA"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </GridLayout>

