<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pos_bg_dark">

    <!-- Zgornja vrstica z gumbi za hode (horizontalno drsenje) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#222222"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/llHodButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHod1"
                style="@style/PosButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3E3E3E"
                android:text="Hod 1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHod2"
                style="@style/PosButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3E3E3E"
                android:text="Hod 2"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHod3"
                style="@style/PosButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3E3E3E"
                android:text="Hod 3"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHod4"
                style="@style/PosButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3E3E3E"
                android:text="Hod 4"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHod5"
                style="@style/PosButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3E3E3E"
                android:text="Hod 5"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHod6"
                style="@style/PosButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3E3E3E"
                android:text="Hod 6"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHod7"
                style="@style/PosButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3E3E3E"
                android:text="Hod 7"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHod8"
                style="@style/PosButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3E3E3E"
                android:text="Hod 8"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHod9"
                style="@style/PosButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3E3E3E"
                android:text="Hod 9"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHod10"
                style="@style/PosButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#3E3E3E"
                android:text="Hod 10"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHodBrez"
                style="@style/PosButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="80dp"
                android:backgroundTint="#555555"
                android:text="Brez"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Iskalno polje z lupo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#1B1B1B">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#AAAAAA" />

        <EditText
            android:id="@+id/etSearchHodi"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Išči artikel..."
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:textSize="16sp"
            android:singleLine="true"
            android:imeOptions="actionDone" />

        <ImageButton
            android:id="@+id/btnClearSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#888888"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444444" />

    <!-- Seznam postavk / artiklov -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHodiList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Spodnja orodna vrstica z gumbi -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1E1E1E">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOK"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/pos_accent_green"
            android:text="Potrdi"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnObvestilo"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#FF8F00"
            android:text="Poziv kuhinji"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:backgroundTint="#616161"
            android:text="Prekliči"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
