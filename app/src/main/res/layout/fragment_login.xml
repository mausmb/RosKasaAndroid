<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pos_bg_dark"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_login"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Container za PRVI ZAGON (Registration) -->
    <LinearLayout
        android:id="@+id/containerFirstRun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_url"
            android:textColor="#CCCCCC" />

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:padding="8dp"
            android:inputType="textUri"
            android:hint="npr. 192.168.1.100/RosKasa"
            android:textColorHint="#777777"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_mobile_id"
            android:textColor="#CCCCCC" />

        <EditText
            android:id="@+id/etMobileId"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:padding="8dp"
            android:inputType="text"
            android:hint="MOB1"
            android:textColorHint="#777777"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_username"
            android:textColor="#CCCCCC" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:padding="8dp"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_password"
            android:textColor="#CCCCCC" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:padding="8dp"
            android:inputType="textPassword"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/btn_potrdi"
            android:backgroundTint="@color/pos_accent_blue"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Container za REDNI ZAGON (PIN / NFC) -->
    <LinearLayout
        android:id="@+id/containerRegularLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_pin"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etPinCode"
            android:layout_width="200dp"
            android:layout_height="54dp"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:gravity="center"
            android:inputType="numberPassword"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnLoginPin"
            android:layout_width="200dp"
            android:layout_height="54dp"
            android:text="Prijava s PIN"
            android:backgroundTint="@color/pos_accent_green"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvNfcHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💳  Prislonite NFC kartico za prijavo"
            android:textColor="#80D8FF"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnResetConfig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ponastavi nastavitve (URL/ID)"
            android:backgroundTint="#777777"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="16dp" />

</LinearLayout>
