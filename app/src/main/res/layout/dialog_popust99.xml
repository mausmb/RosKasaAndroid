<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E272C"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvPopustTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="POPUST NA RAČUN (99)"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/tvRacunSkupaj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Znesek računa: 0,00 €"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- Preklop Procent / Znesek -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTipProcent"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="PROCENT (%)"
            android:backgroundTint="@color/pos_accent_blue"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTipZnesek"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="ZNESEK (€)"
            android:backgroundTint="@color/pos_btn_normal"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Hitri gumbi za procente -->
    <LinearLayout
        android:id="@+id/llHitriProcenti"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuick5"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="5 %"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuick10"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="10 %"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuick15"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="15 %"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuick20"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="20 %"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Vnosno polje -->
    <EditText
        android:id="@+id/etPopustValue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#101820"
        android:textColor="#00FF66"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="end|center_vertical"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:inputType="numberDecimal"
        android:hint="0,00"
        android:textColorHint="#555555" />

    <!-- Predogled izračunanega popusta in novega zneska -->
    <TextView
        android:id="@+id/tvPopustPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Popust: 0,00 €  |  Novo za plačilo: 0,00 €"
        android:textColor="#FFD54F"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <!-- Numpad tipkovnica -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="false"
        android:layout_marginTop="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNum7" style="@style/PosButtonStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="7" android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNum8" style="@style/PosButtonStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="8" android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNum9" style="@style/PosButtonStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="9" android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNum4" style="@style/PosButtonStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="4" android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNum5" style="@style/PosButtonStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="5" android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNum6" style="@style/PosButtonStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="6" android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNum1" style="@style/PosButtonStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="1" android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNum2" style="@style/PosButtonStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="2" android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNum3" style="@style/PosButtonStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="3" android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNumC" style="@style/PosButtonStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="C" android:textSize="18sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNum0" style="@style/PosButtonStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="0" android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNumComma" style="@style/PosButtonStyle" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="," android:textSize="16sp" />
    </GridLayout>

    <!-- Akcijska gumba -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPopustCancel"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="#546E7A"
            android:text="PREKLIČI"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPopustOk"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/pos_accent_green"
            android:text="POTRDI"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
