<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pos_bg_dark">

    <!-- Seznam vrstic naročila -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNarociloItems"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:padding="2dp"
        android:background="#222222" />

    <!-- Statusna vrstica mize in zneska -->
    <TextView
        android:id="@+id/tvMizaStatus"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#111111"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="M: Miza 5  -  Zn: 4,00 / Pl: 0,00" />

    <!-- POS Krmilni gumbi Naročila (Vsi gumbi 56dp višina, alignBounds) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="3"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="false"
        android:padding="1dp">

        <!-- Vrstica 1: Standardna navigacijska vrstica -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavMize"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="@string/btn_mize"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavRacuni"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="@string/btn_racuni"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavNarociSelf"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_accent_blue"
            android:text="@string/btn_naroci"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavPlacila"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="@string/btn_placila"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOdjava"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_accent_red"
            android:text="@string/btn_odjava"
            android:textColor="#FFFFFF" />

        <!-- Vrstica 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrisanje"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="Brisanje"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCenikTipke"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="CENIK/\nTIPKE"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHodi"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="Hod-i"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreklopiCenik"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="PREKLOPI\nCENIK"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNarociPost"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_accent_green"
            android:text="NAROČI"
            android:textColor="#FFFFFF" />

        <!-- Vrstica 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPopust"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="Popust"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGostHotela"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="GOST\nHOTELA"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKreditnaPos"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="KREDITNA K\nPOS"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKredRocno"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="KRED. K\nROCNO"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGotovina"
            style="@style/PosButtonStyle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/pos_btn_normal"
            android:text="Gotovina"
            android:textColor="#FFFFFF" />
    </GridLayout>

    <!-- Mreža Hitrih Tipk za Kategorije in Artikle -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQuickKeys"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="1dp"
        android:background="#1B1B1B" />

    <!-- Kontejner za Seznam Artiklov iz Cenika z Iskalno vrstico -->
    <LinearLayout
        android:id="@+id/llCenikContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#263238"
        android:visibility="gone">

        <!-- Iskalna vrstica za celotno listo cenika -->
        <LinearLayout
            android:id="@+id/llCenikSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#37474F"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 "
                android:textColor="#CCCCCC"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etSearchCenik"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Išči artikel po nazivu ali kodi (npr. coc)..."
                android:textColor="#FFFFFF"
                android:textColorHint="#90A4AE"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Počisti iskanje"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#B0BEC5" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCenikList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="2dp"
            android:background="#111111" />
    </LinearLayout>

</LinearLayout>

